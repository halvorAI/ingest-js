# Demo only. Use testnet wallets and a facilitator that supports Base Sepolia exact payments.
RECEIVER_ADDRESS=
FACILITATOR_URL=
PORT=4021
API_BASE_URL=http://localhost:4021
# Disposable TESTNET payer wallet. Never use your main wallet or upload keys.
DEMO_PAYER_PRIVATE_KEY=
